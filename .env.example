# ── Bază de date ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://demo:demo123@localhost:5433/rag_demo

# ── LLM pentru agenți (Orchestrator, Analyst, server MCP) ────────────────────
# Alege UN provider. LLM_PROVIDER decide providerul; modelul vine din
# <PROVIDER>_MODEL (ex. OPENAI_MODEL) sau din LLM_MODEL (override global).
# Alias-uri acceptate: gemini→google, ollama→local.

# OpenAI / OpenRouter (setup-ul folosit aici: OpenRouter cu gpt-4o-mini)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1   # omite linia pt OpenAI direct
OPENAI_MODEL=openai/gpt-4o-mini                # pt OpenAI direct: gpt-4o-mini

# Gemini
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-key-here
# GOOGLE_MODEL=gemini-1.5-flash

# Ollama (local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Anthropic (necesar doar pentru prompt caching - scripts/prompt_caching.py) ─
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
